<?xml version="1.0" encoding="utf-8"?>
<!--
    Small widget background - lighter amber gradient
    Adjusted to be lighter and less saturated for better readability
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#E8D494"
        android:centerColor="#DDBE6F"
        android:endColor="#D9B560"
        android:type="linear" />
    <corners android:radius="24dp" />
</shape>
