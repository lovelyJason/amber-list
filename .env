# 琥珀清单环境配置
# 此文件包含编译时配置，如果有秘钥，不应提交到版本控制
# 改完 .env 一定要先 build_runner clean 再 build

# 密钥存储方式
# keychain - 使用系统钥匙串存储（macOS Keychain / Windows Credential Manager）
# shared_preferences - 使用 SharedPreferences 存储（不推荐用于敏感数据）
SECRET_STORAGE_TYPE=shared_preferences

# 应用更新检查 API 地址
# 可以是 GitHub Raw、CDN、自建服务器等
APP_UPDATE_URL=https://cdn.qdovo.com/hupo/update.json

# ============================================================
# 激活码验证配置
# ============================================================

# 激活码验证 API 地址
# ACTIVATION_API_URL=http://127.0.0.1:7002/api/v1
ACTIVATION_API_URL=https://mall.qdovo.com/api/v1

# HMAC 签名密钥（前后端必须保持一致）
# 生产环境请修改为随机生成的强密钥
HUPO_HMAC_SECRET_KEY=amber_list_default_secret_key_2026

# ============================================================
# 便签窗口渲染模式配置
# ============================================================

# 使用位标志控制各平台的便签窗口渲染方式
# Bit 0 (值1): macOS 使用原生 AppKit 渲染
# Bit 1 (值2): Windows 使用原生 Win32/GDI+ 渲染
#
# 组合示例：
#   0 = 所有平台使用 Flutter 渲染（desktop_multi_window）
#   1 = 仅 macOS 使用原生，Windows 使用 Flutter
#   2 = 仅 Windows 使用原生，macOS 使用 Flutter
#   3 = macOS 和 Windows 都使用原生渲染
#
# 默认值：3（macOS和Windows都使用原生渲染）
# 注意：Flutter desktop_multi_window 在 Windows 上有严重 bug
# 关闭窗口后再创建新窗口会导致整个应用崩溃
# 参考: https://github.com/flutter/flutter/issues/155685
STICKY_NOTE_NATIVE_MODE=3
