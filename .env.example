# 琥珀清单环境配置示例
# 复制此文件为 .env 并根据需要修改
# 改完 .env 一定要先 build_runner clean 再 build

# 密钥存储方式
# keychain - 使用系统钥匙串存储（macOS Keychain / Windows Credential Manager）
# shared_preferences - 使用 SharedPreferences 存储（不推荐用于敏感数据）
SECRET_STORAGE_TYPE=keychain

# 应用更新检查 API 地址
# 可以是 GitHub Raw、CDN、自建服务器等
APP_UPDATE_URL=https://raw.githubusercontent.com/YOUR_USERNAME/amber-list/main/update.json
